# GLM-5.3-Flash — 2× DGX Spark example environment
# Copy to .env and adjust for your cluster. Do not commit .env.

# --- Models (revision must NOT be pinned) ---
MODEL=canada-quant/glm-5.3-w4a16-mtp
DRAFT_MODEL=incoai/GLM-5.3-Flash-DFlash2
# Optional: only when Hub requires auth. Never bake into the image.
# HF_TOKEN=

# --- Host HF cache mount (standard HF paths only; no /var/tmp) ---
# HF_CACHE=/home/YOUR_USER/.cache/huggingface

# --- Cluster topology (same HEAD_HOST on every node) ---
HEAD_HOST=192.168.100.10
WORKER_HOST=192.168.100.20
# ROLE=head|worker  — set per node by launcher, do not hardcode in image

TP_SIZE=2
NNODES=2

# --- Context / batching (2-node unified memory; conservative defaults) ---
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
# KV_CACHE_MEMORY=
GPU_MEM_UTIL=0.88

# --- DFlash2 (enabled by default) ---
DFLASH_TOKENS=7
DFLASH_SELECTOR_TOP_K=32
DFLASH_WALK_MODE=edge
DFLASH2_ACC_PROBE=0

# --- Production baseline (already validated; do not re-A/B casually) ---
MOE_BACKEND=marlin
ENFORCE_EAGER=1
DISABLE_FLASHINFER_AUTOTUNE=1
ASYNC_SCHEDULING=1
APPLY_APC_PATCH=1

# --- NCCL / RoCE (change if your interface names differ; up.sh must validate) ---
NCCL_IB_GID_INDEX=3
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0
