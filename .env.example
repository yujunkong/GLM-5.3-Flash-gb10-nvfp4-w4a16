# GLM-5.3-Flash — 2× DGX Spark example environment
# Copy to .env on EVERY node. ROLE / NODE_RANK / MENTAT_NODE_IP are the usual per-node diffs.
# Do not commit .env. Never pin MODEL_REVISION / --revision.

# --- per node ---
ROLE=head
NODE_RANK=0
# mentatd identity (must match CLUSTER_SUBNET address on this node)
MENTAT_NODE_IP=192.168.100.10
MENTAT_PEERS=192.168.100.20:6379

# --- models (Hub ids; revision NOT pinned) ---
MODEL=canada-quant/glm-5.3-w4a16-mtp
DRAFT_MODEL=incoai/GLM-5.3-Flash-DFlash2
# HF_TOKEN=   # optional for gated/private; never bake into image

# --- caches (standard HF layout under HOST_CACHE; no /var/tmp) ---
# HOST_CACHE mounts to /root/.cache → Hub models at .../huggingface
HOST_CACHE=/home/yujunkong/.cache
LOG_DIR=/home/yujunkong/logs/glm53
EXT_DIR=/home/yujunkong/ext

# --- cluster (same HEAD_HOST on every node) ---
HEAD_HOST=192.168.100.10
WORKER_HOST=192.168.100.20
CLUSTER_SUBNET=192.168.100.
TP_SIZE=2
TP=2
NNODES=2
IMAGE=glm53-spark:2x-sm121

# --- NCCL / RoCE (leave GID/HCA empty to auto-derive unless site requires pin) ---
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0
NCCL_IB_GID_INDEX=3

# --- serving / production baseline ---
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEM_UTIL=0.88
MOE_BACKEND=marlin
CUDA_GRAPHS=0
ENFORCE_EAGER=1
DISABLE_FLASHINFER_AUTOTUNE=1
ASYNC_SCHEDULING=1
APPLY_APC_PATCH=1
MTP=0
DFLASH_TOKENS=7
DFLASH_SELECTOR_TOP_K=32
DFLASH_WALK_MODE=edge
DFLASH2_ACC_PROBE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- launcher ---
SSH_USER=yujunkong
COMPOSE_FILES="-f compose/glm53.yaml -f compose/overrides/production.yaml -f compose/overrides/dflash2.yaml"
