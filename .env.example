# New-repo .env — upstream image + mp TP2 for canada-quant W4A16-MTP
# Copy to .env on both nodes. ROLE is set by compose profile; HEAD_HOST identical everywhere.

HEAD_HOST=192.168.100.10
WORKER_HOST=192.168.100.20
CLUSTER_SUBNET=192.168.100.
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_RANGE=192.168.100.0/24

IMAGE=glm53-spark:2x-sm121
BASE=vllm/vllm-openai:glm53-flash-arm64-cu130
DIST_BACKEND=mp
TP_SIZE=2
NNODES=2
MASTER_PORT=29521
API_PORT=8000

# Hub ids — revision NOT pinned
MODEL=canada-quant/glm-5.3-w4a16-mtp
DRAFT_MODEL=incoai/GLM-5.3-Flash-DFlash2
SERVED_MODEL_NAME=glm-5.3-flash
SPEC_METHOD=dflash
DFLASH_TOKENS=7
DFLASH_SELECTOR_TOP_K=32
DFLASH_WALK_MODE=edge
# 0 = Golden (no probe I/O). 1 = analysis boot only: /logs JSON+CSV + A/B/C
# (~-10% soak). Never leave 1 in production.
DFLASH2_ACC_PROBE=0

HOST_CACHE=/home/yujunkong/.cache
LOG_DIR=/home/yujunkong/logs/glm53
EXT_DIR=/home/yujunkong/ext

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEM_UTIL=0.85
KV_CACHE_MEMORY=9663676416
KV_CACHE_DTYPE=fp8_e4m3
BLOCK_SIZE=2304
MOE_BACKEND=marlin
CUDA_GRAPHS=0
ASYNC_SCHEDULING=1
DISABLE_FLASHINFER_AUTOTUNE=1
VLLM_MARLIN_USE_ATOMIC_ADD=1
VLLM_USE_FUSED_MOE_GROUPED_TOPK=1
# Production KEEP: SM90 (GLM53_SM121_MLA=0). APC generated by scripts/gen-apc.sh
GLM53_SM121_MLA=0
APPLY_APC_PATCH=1
APPLY_GATE_LINEAR=0
APC_PATCH_HOST=../runtime/apc/coordinator.patched.py
LOCK_CLOCKS=1
CLOCK_MHZ=2400

SSH_USER=yujunkong
REMOTE_ROOT=/home/yujunkong/workspace/docker/GLM-5.3-Flash-gb10-nvfp4-w4a16
