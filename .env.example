# Golden .env — W4A16 2× DGX Spark (v1.0.0-golden)
# Copy to `.env` on HEAD and WORKER. ROLE comes from compose profile; HEAD_HOST identical.
# Canonical: docs/golden-configuration.md — do not enable Rejected knobs below.

# --- Cluster / network ---
HEAD_HOST=192.168.100.10
WORKER_HOST=192.168.100.20
CLUSTER_SUBNET=192.168.100.
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_RANGE=192.168.100.0/24
SSH_USER=yujunkong
REMOTE_ROOT=/home/yujunkong/workspace/docker/GLM-5.3-Flash-gb10-nvfp4-w4a16

# --- Image / topology ---
IMAGE=glm53-spark:2x-sm121
BASE=vllm/vllm-openai:glm53-flash-arm64-cu130
DIST_BACKEND=mp
TP_SIZE=2
NNODES=2
MASTER_PORT=29521
API_PORT=8000

# --- Models (Hub ids; revision NOT pinned) ---
# SERVE_LANE selects checkpoint + glm5next overlay (scripts/apply-serve-lane.sh).
#   golden   (default) = canada-quant W4A16-MTP + patches/glm5next_model.py
#   modelopt           = axiomofmind ModelOpt W4A16_NVFP4
#                        glm5next: patches/glm5next_model.modelopt.py (Eagle3)
#                        try APPLY_GATE_LINEAR=1 (measured speed-up on modelopt)
SERVE_LANE=golden
MODEL_GOLDEN=canada-quant/glm-5.3-w4a16-mtp
MODEL_MODELOPT=axiomofmind/GLM-5.3-Flash-W4A16-NVFP4
# Optional explicit overrides (usually leave unset — lane script sets MODEL):
# MODEL=canada-quant/glm-5.3-w4a16-mtp
# GLM5NEXT_PATCH_HOST=../patches/glm5next_model.py
# GLM5NEXT_PATCH_HOST_MODELOPT=../patches/glm5next_model.modelopt.py
DRAFT_MODEL=incoai/GLM-5.3-Flash-DFlash2
SERVED_MODEL_NAME=glm-5.3-flash
SPEC_METHOD=dflash

# --- DFlash2 Golden ---
DFLASH_TOKENS=7
DFLASH_SELECTOR_TOP_K=32
DFLASH_WALK_MODE=edge
# 0 = production. 1 = analysis only (~−10% soak). Never leave 1 in prod.
DFLASH2_ACC_PROBE=0

# --- Serve Golden ---
MOE_BACKEND=marlin
ENFORCE_EAGER=1
CUDA_GRAPHS=0
ASYNC_SCHEDULING=1
DISABLE_FLASHINFER_AUTOTUNE=1
VLLM_MARLIN_USE_ATOMIC_ADD=1
VLLM_USE_FUSED_MOE_GROUPED_TOPK=1

# --- Memory / KV ---
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEM_UTIL=0.85
KV_CACHE_MEMORY=9663676416
KV_CACHE_DTYPE=fp8_e4m3
BLOCK_SIZE=2304

# --- Allocator / sparse indexer (Golden) ---
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=512
# REJECTED: VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=64  (TPS −2.77% on this stack)

# --- Overlays / paths ---
HOST_CACHE=/home/yujunkong/.cache
LOG_DIR=/home/yujunkong/logs/glm53
EXT_DIR=/home/yujunkong/ext
# Production KEEP: SM90 path (not SM121 MLA default)
GLM53_SM121_MLA=0
APPLY_APC_PATCH=1
# Golden default OFF. ModelOpt lane: set 1 (compose/overrides/gate-linear.yaml via up.sh).
APPLY_GATE_LINEAR=0
APC_PATCH_HOST=../runtime/apc/coordinator.patched.py

# --- Clocks ---
LOCK_CLOCKS=1
CLOCK_MHZ=2400

# --- Spin-wait (Golden = pristine / busy_loop_s=1.0) ---
# REJECTED: .../shm_broadcast.patched.py (busy_loop_s=0.002 → TPS −1.63%, drift worse)
SPINWAIT_PATCH_HOST=../runtime/spinwait/shm_broadcast.pristine.py

# --- Ops telemetry (optional; no decode-path change) ---
# python3 scripts/tps_drift_logger.py --out "$LOG_DIR/tps-drift.csv" --interval 30

# Silence Triton JIT *warnings* after warmup (1=default). One-time compile for a
# brand-new shape still happens; only the WARNING log is suppressed.
# Set 0 to restore stock WARNING logs.
GLM53_JIT_MONITOR_SILENT=1
JIT_MONITOR_PATCH_HOST=../runtime/jit/jit_monitor.patched.py
